# The installer generates host-specific settings.json. No shell sourcing or credentials.
# Exact frozen inference overrides; these are not tuning controls.
ONEAPI_DEVICE_SELECTOR=level_zero:0
SYCL_CACHE_PERSISTENT=0
STRATA_VERIFY_DEVICE_PLAN=1
STRATA_STAGER_THREADS=12
STRATA_ARENA_ALIAS_CHECK=1
STRATA_HOST_UNCACHED=1
STRATA_DECODE_TIMING=1
STRATA_VERIFY_TRACE=1
STRATA_APLAN_DIAG=1
